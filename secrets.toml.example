# Copy this file to .streamlit/secrets.toml and fill in your Supabase project values.
#
# Find these in Supabase: Project Settings -> API
#   SUPABASE_URL = the "Project URL"  (e.g. https://abcdefgh.supabase.co)
#   SUPABASE_KEY = the "anon public" key  (NOT the service_role key)
#
# The anon key is safe to use from a client because RLS would normally restrict
# access. You've turned RLS off for this dev setup, so anyone with this key + URL
# could read/write your tables — keep secrets.toml out of git.

SUPABASE_URL = "https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_KEY = "your-anon-public-key-here"
